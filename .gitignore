*.log
*.tmp
*.temp
*.swp
*.swo
*~
*.bak

# ------------------------------------------------------------------------------
# 9. Machine Learning Models, Serialized Checkpoints, and Tracking
# ------------------------------------------------------------------------------
/models/
checkpoints/
*.pkl
*.joblib
*.pt
*.pth
*.onnx
*.h5
wandb/
runs/
mlruns/

# ------------------------------------------------------------------------------
# 10. Large Downloaded and Generated Datasets (~29 MB total)
# ------------------------------------------------------------------------------
# Prevent large raw and generated dataset splits from being added to Git.
# All data splits can be deterministically reproduced via:
#   PYTHONPATH=. python3 src/data/prepare_dataset.py
data/raw/*.jsonl
data/processed/*.jsonl
data/synthetic/*.jsonl
*.parquet
*.tar.gz
*.zip

# Preserve dataset schemas, configuration, and non-sensitive provenance metadata
!data/raw/raw_provenance_metadata.json
!data/synthetic/synthetic_generation_metadata.json
!data/processed/label2id.json
!data/processed/id2label.json

# ------------------------------------------------------------------------------
# 11. Local presentation / viva materials
# ------------------------------------------------------------------------------
Medical_NER_Three_Member_Presentation_and_Viva_Guide.pdf
Medical_NER_Complete_Approach_and_Results.pdf

